{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bac-calculator": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/bac-calculator",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "manifest.webmanifest", "input": "src", "output": "/" },
              { "glob": "sw.js", "input": "src", "output": "/" },
              { "glob": "**/*", "input": "src/icons", "output": "/icons" }
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all"
            },
            "social": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "3mb"
                }
              ],
              "outputHashing": "all",
              "outputPath": "dist/suparkompisen-social",
              "assets": [
                { "glob": "manifest.webmanifest", "input": "src/social", "output": "/" },
                { "glob": "sw.js", "input": "src", "output": "/" },
                { "glob": "**/*", "input": "src/social/icons", "output": "/icons" }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.social.ts"
                },
                {
                  "replace": "src/app/services/supabase.service.ts",
                  "with": "src/app/services/supabase.service.real.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "bac-calculator:build:production"
            },
            "development": {
              "buildTarget": "bac-calculator:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
